<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mina &amp; Maria’s Engagement</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap">
<style>
:root{
  --bg:#FBF8F3; --surface:#F1EADF; --ink:#3A2A22; --muted:#6F5F53;
  --gold:#8A6A22; --gold-soft:#C9A24B; --line:#E2D6C2; --btn-ink:#FBF8F3;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1E1814; --surface:#2A2220; --ink:#F3EBDD; --muted:#BDAE9B;
    --gold:#D4B062; --gold-soft:#D4B062; --line:#3D322C; --btn-ink:#1E1814; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#1E1814; --surface:#2A2220; --ink:#F3EBDD; --muted:#BDAE9B;
  --gold:#D4B062; --gold-soft:#D4B062; --line:#3D322C; --btn-ink:#1E1814; color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{position:relative;overflow-x:hidden;margin:0;background:var(--bg) radial-gradient(ellipse at 50% 0,rgba(201,162,75,.12),transparent 60%) no-repeat;color:var(--ink);font-family:"Jost",system-ui,sans-serif;font-weight:300;line-height:1.6;-webkit-font-smoothing:antialiased}
main{position:relative;z-index:1;max-width:640px;margin:0 auto;padding:40px 24px 72px;text-align:center}
.photo{width:min(100%,400px);aspect-ratio:874/1280;margin:0 auto;border-radius:200px 200px 10px 10px;overflow:hidden;box-shadow:0 0 0 1px var(--line),0 0 0 10px var(--bg),0 0 0 11px var(--gold-soft);animation:rise 1.2s ease both}
.photo img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
h1{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500;font-style:italic;font-size:clamp(3.2rem,15vw,5.4rem);line-height:1;margin:44px 0 10px;letter-spacing:-.01em}
h1 span{color:var(--gold);font-weight:400;padding:0 .08em}
.lede{font-family:"Cormorant Garamond",Georgia,serif;font-size:1.4rem;margin:0;color:var(--muted)}
.drape{display:block;width:180px;height:28px;margin:34px auto}
.date{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(1.7rem,7vw,2.3rem);font-weight:400;margin:0}
.time{margin:2px 0 0;color:var(--muted);font-size:1.05rem}
.count{display:flex;justify-content:center;gap:clamp(14px,5vw,34px);margin:36px 0 0}
.count div{min-width:58px}
.count b{display:block;font-family:"Cormorant Garamond",Georgia,serif;font-weight:400;font-size:2.6rem;line-height:1;color:var(--gold)}
.count small{font-size:.9rem;color:var(--muted)}
.card{margin:56px 0 0;background:var(--surface);border-radius:14px;padding:36px 24px}
.card h2{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500;font-size:2rem;margin:0 0 20px}
.card p{margin:0 0 4px}
.place{font-family:"Cormorant Garamond",Georgia,serif;font-size:1.6rem;font-weight:600}
.btns{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:26px}
.btn{display:inline-block;padding:13px 24px;border-radius:999px;text-decoration:none;font-weight:500;font-size:1rem;border:1px solid var(--gold);transition:background .2s,color .2s}
.btn.fill{background:var(--gold);color:var(--btn-ink)}
.btn.line{color:var(--gold)}
.btn:hover{opacity:.88}
.btn:focus-visible{outline:3px solid var(--gold-soft);outline-offset:3px}
.foot{margin:48px 0 0;font-family:"Cormorant Garamond",Georgia,serif;font-style:italic;font-size:1.35rem;color:var(--muted)}
.theme{position:fixed;top:calc(env(safe-area-inset-top,0px) + 12px);right:12px;z-index:5;width:44px;height:44px;border-radius:50%;border:1px solid var(--gold-soft);background:var(--surface);color:var(--ink);font-size:1.25rem;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0}
.theme:focus-visible{outline:3px solid var(--gold-soft);outline-offset:3px}
:root{--wash:rgba(251,248,243,.38)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--wash:rgba(30,24,20,.74)}}
:root[data-theme="dark"]{--wash:rgba(30,24,20,.74)}
body::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(var(--wash),var(--wash)),url(data:image/jpeg;base64,) center top/cover no-repeat}
.card{background:color-mix(in srgb,var(--surface) 88%,transparent)}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.photo{animation:none}}
</style>
</head>
<body>
<button class="theme" id="theme" type="button" aria-label="Switch to dark mode" title="Light / dark mode">🌙</button>
<main>
  <div class="photo"><img src="data:image/jpeg;base64," alt="Mina and Maria smiling together in front of white draped curtains"></div>
  <h1>Mina <span>&amp;</span> Maria</h1>
  <p class="lede">Join us as we celebrate our engagement</p>

  <svg class="drape" viewBox="0 0 180 28" fill="none" stroke="var(--gold-soft)" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
    <path d="M4 4 C50 4 70 24 90 24 C110 24 130 4 176 4"/>
    <path d="M4 24 C50 24 70 4 90 4 C110 4 130 24 176 24"/>
  </svg>

  <p class="date">Saturday, November 21, 2026</p>
  <p class="time">at 7:00 pm</p>

  <div class="count" id="count" aria-live="off">
    <div><b id="d">0</b><small>days</small></div>
    <div><b id="h">0</b><small>hours</small></div>
    <div><b id="m">0</b><small>minutes</small></div>
  </div>

  <section class="card" id="details">
    <h2>Where we’ll celebrate</h2>
    <p class="place">Marassi cafe</p>
    <p>Beni Suef</p>
    <div class="btns">
      <a class="btn fill" href="https://www.google.com/maps?q=34F8+Q89+Cafe+Marissa,+%D8%A8%D8%AC%D9%88%D8%A7%D8%B1+%D9%85%D8%B3%D8%AA%D8%B4%D9%81%D9%8A+%D8%A7%D9%84%D8%AA%D8%A3%D9%85%D9%8A%D9%86+%D8%A7%D9%84%D8%B5%D8%AD%D9%8A,+%D9%83%D9%88%D8%B1%D9%86%D9%8A%D8%B4+%D8%A7%D9%84%D9%86%D9%8A%D9%84,+Qism+Bani+Sweif,+Beni+Suef,+Beni+Suef+Governorate+2721325&amp;ftid=0x145a27001a839255:0x8fbb8af87fe2506">Open in Maps</a>
      <a class="btn line" href="https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text=Mina+%26+Maria%27s+Engagement&amp;dates=20261121T170000Z%2F20261121T200000Z&amp;location=Marassi+cafe%2C+Beni+Suef">Add to calendar</a>
    </div>
  </section>

  <p class="foot">We can’t wait to celebrate with you.</p>
</main>
<script>
(function(){
  var root=document.documentElement,btn=document.getElementById("theme");
  function isDark(){var t=root.getAttribute("data-theme");return t?t==="dark":matchMedia("(prefers-color-scheme: dark)").matches;}
  function paint(){var d=isDark();btn.textContent=d?"☀️":"🌙";btn.setAttribute("aria-label",d?"Switch to light mode":"Switch to dark mode");}
  btn.addEventListener("click",function(){root.setAttribute("data-theme",isDark()?"light":"dark");paint();});
  paint();
})();
(function(){
  var target=new Date("2026-11-21T19:00:00+02:00").getTime();
  var d=document.getElementById("d"),h=document.getElementById("h"),m=document.getElementById("m"),box=document.getElementById("count");
  function tick(){
    var s=Math.floor((target-Date.now())/1000);
    if(s<=0){box.style.display="none";return;}
    d.textContent=Math.floor(s/86400);
    h.textContent=Math.floor(s%86400/3600);
    m.textContent=Math.floor(s%3600/60);
  }
  tick();setInterval(tick,30000);
})();
</script>
</body>
</html>
